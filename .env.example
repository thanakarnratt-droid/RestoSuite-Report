# Copy to .env and fill in. .env holds your login token and must never be committed.

# Token: log in at https://bo.sea.restosuite.ai, open DevTools > Console and run
#   localStorage.getItem("vulcan-Token")
# Paste the value without quotes. It stops working when you log out.
RESTOSUITE_TOKEN=

# Comma-separated store IDs, e.g. 406937599
RESTOSUITE_SHOP_IDS=

# Account headers the report page sends. Find them in DevTools > Network:
# open the Orders report, click Query, select the "queryData" request and
# copy Brand-Id, Corporation-Id and Organization-Id from its request headers.
RESTOSUITE_BRAND_ID=
RESTOSUITE_CORPORATION_ID=
RESTOSUITE_ORGANIZATION_ID=

# Optional
# RESTOSUITE_LANGUAGE=en_US
# RESTOSUITE_TIMEZONE=Asia/Bangkok
